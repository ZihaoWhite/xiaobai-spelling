#!/bin/zsh

set -u

PROJECT_DIR="/Users/zihaobai/Documents/小白单词"
PYTHON_BIN="$PROJECT_DIR/.venv/bin/python"
APP_FILE="$PROJECT_DIR/app.py"
RUNTIME_DIR="$PROJECT_DIR/.runtime"
LOG_FILE="$RUNTIME_DIR/streamlit-launchd.log"
PORT="8510"
APP_URL="http://127.0.0.1:$PORT"
HEALTH_URL="$APP_URL/_stcore/health"

is_ready() {
    /usr/bin/curl -fsS --max-time 1 "$HEALTH_URL" >/dev/null 2>&1
}

if [[ ! -x "$PYTHON_BIN" ]]; then
    /usr/bin/osascript -e \
        'display dialog "项目的 Python 环境不存在，请先在项目目录安装依赖。" with title "小白拼写暂时无法启动" buttons {"好"} default button "好" with icon stop'
    exit 1
fi

if [[ ! -f "$APP_FILE" ]]; then
    /usr/bin/osascript -e \
        'display dialog "没有找到 app.py，请确认项目文件夹没有被移动。" with title "小白拼写暂时无法启动" buttons {"好"} default button "好" with icon stop'
    exit 1
fi

/bin/mkdir -p "$RUNTIME_DIR"

if ! is_ready; then
    : > "$LOG_FILE"
    monitor_pid=""
    server_pid=""
    cleanup() {
        if [[ -n "$monitor_pid" ]]; then
            /bin/kill "$monitor_pid" 2>/dev/null || true
        fi
        if [[ -n "$server_pid" ]]; then
            /bin/kill "$server_pid" 2>/dev/null || true
        fi
    }
    trap cleanup EXIT INT TERM HUP
    (
        for _attempt in {1..120}; do
            if is_ready; then
                /usr/bin/open "$APP_URL"
                exit 0
            fi
            /bin/sleep 0.25
        done
        /usr/bin/osascript -e \
            'display dialog "请查看项目中的 .runtime/streamlit-launchd.log 获取详细原因。" with title "小白拼写启动失败" buttons {"好"} default button "好" with icon caution'
    ) &
    monitor_pid=$!
    "$PYTHON_BIN" -m streamlit run "$APP_FILE" \
        --server.address 127.0.0.1 \
        --server.port "$PORT" \
        --server.headless true \
        --browser.gatherUsageStats false \
        >> "$LOG_FILE" 2>&1 &
    server_pid=$!
    wait "$server_pid"
    server_status=$?
    exit "$server_status"
fi

/usr/bin/open "$APP_URL"
